# Optional: Add a free-tier LLM API key to switch from local deterministic agent mode to live LLM mode.
# Leave blank to run in zero-key Local Agent Mode (works out of the box).
LLM_PROVIDER=local
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Optional webhook secret for /webhook/support-email
WEBHOOK_SECRET=
